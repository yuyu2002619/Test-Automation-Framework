# Core API settings
TAF_API_BASE_URL=http://127.0.0.1:8787
TAF_API_TIMEOUT=60
TAF_TLS_VERIFY=true
TAF_REPORT_TYPE=allure

# Local mock Web UI used by Playwright tests. These are non-production demo credentials.
TAF_WEB_BASE_URL=http://127.0.0.1:8787
TAF_WEB_USERNAME=test123
TAF_WEB_PASSWORD=qwe666

# DingTalk notification settings. Keep disabled unless both values are set.
TAF_DINGTALK_ENABLED=false
TAF_DINGTALK_WEBHOOK=
TAF_DINGTALK_SECRET=

# MySQL
TAF_MYSQL_HOST=127.0.0.1
TAF_MYSQL_PORT=3306
TAF_MYSQL_USERNAME=
TAF_MYSQL_PASSWORD=
TAF_MYSQL_DATABASE=

# Redis
TAF_REDIS_HOST=127.0.0.1
TAF_REDIS_PORT=6379
TAF_REDIS_USERNAME=
TAF_REDIS_PASSWORD=
TAF_REDIS_DB=0

# ClickHouse
TAF_CLICKHOUSE_HOST=127.0.0.1
TAF_CLICKHOUSE_PORT=8123
TAF_CLICKHOUSE_USERNAME=default
TAF_CLICKHOUSE_PASSWORD=
TAF_CLICKHOUSE_TIMEOUT=10
TAF_CLICKHOUSE_DB=default

# MongoDB
